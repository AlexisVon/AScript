$io_print("\n");

def classify(n) {
  if (n > 0) {
    return "positive";
  } else if (n < 0) {
    return "negative";
  }
  return "zero";
}
$io_print(classify(5));
$io_print("\n");
$io_print(classify(-3));
$io_print("\n");
$io_print(classify(0));
$io_print("\n");
