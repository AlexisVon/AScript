// Test: inner throw caught by outer catch
try {
    try {
        throw "inner error";
    } catch (e) {
        $io_print("inner caught: what=%1, info=%2\n", e.what, e.info);
        throw "rethrown from inner";
    }
} catch (e) {
    $io_print("outer caught: what=%1, info=%2\n", e.what, e.info);
}
