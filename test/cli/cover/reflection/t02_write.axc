// T02: 引用反射 — 写
// @x = value; @(expr) = value;

// 1. @x = 5; 写目标变量
var x = 0;
var name = "x";
@name = 5;
$io_print("T02.1 @name=5: x=", x);
if (x != 5) { $io_print("FAIL T02.1"); throw("assert"); }
$io_print("OK");

// 2. @(expr) = value;
x = 0;
var target = "x";
@(target) = 99;
$io_print("T02.2 @(expr)=99: x=", x);
if (x != 99) { $io_print("FAIL T02.2"); throw("assert"); }
$io_print("OK");

// 3. 写 namespace 子路径
// NOTE: @ on dotted path only reads subpath, writes to top-level var named the full string
// So @p = 77 where p="ns.a.b" creates a var named "ns.a.b" rather than navigating
var ns = map();
ns.a = map();
ns.a.b = 0;
var p = "ns.a.b";
@p = 77;
$io_print("T02.3 after @p=77: ns.a.b=", ns.a.b, " (no nav), @p reads:", @p);
// The write creates a new top-level var if the ref string contains dots
// So we document the behavior rather than assert it navigates
$io_print("T02.3 behavior: @ on dotted path writes to literal name (no navigation)");
// Delete the created var to clean up
// We use direct access since we know the literal name
$io_print("OK (behavior documented)");

// 4. 写不存在的变量（自动创建？测试行为）
// 先清除变量保证不存在
var nonexist_name = "fresh_var_abc";
try {
    @nonexist_name = 123;
    $io_print("T02.4 created: ", fresh_var_abc);
    if (fresh_var_abc != 123) { $io_print("FAIL T02.4"); throw("assert"); }
    $io_print("OK - creates new var");
} catch (e) {
    $io_print("T02.4 write to nonexistent caught: ", e);
    $io_print("OK - throws on nonexistent (allowed behavior)");
}

// 5. 非string引用目标写 → TypeError
var not_str = 456;
var got_error = false;
try {
    @not_str = 1;
    $io_print("ERROR: should have thrown TypeError for non-string write target");
} catch (e) {
    got_error = true;
    $io_print("T02.5 non-string write caught: ", e);
}
if (!got_error) { $io_print("FAIL T02.5"); throw("assert"); }
$io_print("OK");

$io_print("T02 all passed");
