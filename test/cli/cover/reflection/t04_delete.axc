// T04: 引用反射 — 删除
// delete @x; 删除目标变量

// 1. delete @x; 删除目标变量
var x = 42;
var name = "x";
delete @name;
var got_error = false;
try {
    var tmp = x;
    $io_print("x after delete: ", tmp);
} catch (e) {
    got_error = true;
    $io_print("T04.1 delete @x caught: ", e);
}
if (!got_error) { $io_print("FAIL T04.1 - x should be gone"); throw("assert"); }
$io_print("OK");

// 2. delete @(expr)
var y = 99;
var target = "y";
delete @(target);
got_error = false;
try {
    var tmp = y;
    $io_print("y after delete: ", tmp);
} catch (e) {
    got_error = true;
    $io_print("T04.2 delete @(expr) caught: ", e);
}
if (!got_error) { $io_print("FAIL T04.2 - y should be gone"); throw("assert"); }
$io_print("OK");

// 3. delete @nonexistent → silent no-op (already doesn't exist)
var missing = "does_not_exist_xyz";
delete @missing;
$io_print("T04.3 delete @nonexistent silent no-op OK");

// 4. delete @non_string → TypeError
var not_str = 123;
var caught = false;
try {
    delete @not_str;
    $io_print("ERROR: should have thrown TypeError for non-string delete target");
} catch (e) {
    caught = true;
    $io_print("T04.4 non-string delete caught: ", e);
}
if (!caught) { $io_print("FAIL T04.4"); throw("assert"); }
$io_print("OK");

// 5. @ delete knows dotted paths as literal name only (no navigation on write-side)
// delete @p where p="ns.a.b" deletes the literal var named "ns.a.b"
var ns = map();
ns.a = map();
ns.a.b = 42;
var p = "ns.a.b";
// Read via @ for the literal name first - it should not exist
// (we haven't created a top-level var called "ns.a.b")
// delete @p will try to delete "ns.a.b" which doesn't exist at top level - expect throw
caught = false;
try {
    delete @p;
    $io_print("T04.5 delete @p (dotted) succeeded (no-op?)");
} catch (e) {
    caught = true;
    $io_print("T04.5 delete dotted path caught: ", e);
}
var vb = ns.a.b;
$io_print("T04.5 ns.a.b still=", vb);
$io_print("OK (behavior documented: @ delete only operates on literal top-level name)");

$io_print("T04 all passed");
