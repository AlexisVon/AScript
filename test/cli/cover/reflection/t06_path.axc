// T06: 路径字符串
// @("arr[0]") 含索引的路径，含.和[]的复杂路径

// 1. @("arr[0]") = 99; 含索引的路径——写
var arr = [10, 20, 30];
var p = "arr[0]";
@p = 99;
$io_print("T06.1 @arr[0]=99:", arr[0]);
if (arr[0] != 99) { $io_print("FAIL T06.1"); throw("assert"); }
$io_print("OK");

// 2. @arr[0] 读
arr = [10, 20, 30];
p = "arr[0]";
var val = @p;
$io_print("T06.2 @arr[0] read:", val);
if (val != 10) { $io_print("FAIL T06.2"); throw("assert"); }
$io_print("OK");

// 3. 含.和[]的复杂路径
var ns = map();
ns.items = [1, 2, 3];
var cp = "ns.items[1]";
var v = @cp;
$io_print("T06.3 ns.items[1]:", v);
if (v != 2) { $io_print("FAIL T06.3"); throw("assert"); }
$io_print("OK");

// 4. 写复杂路径
cp = "ns.items[2]";
@cp = 99;
$io_print("T06.4 write ns.items[2]:", ns.items[2]);
if (ns.items[2] != 99) { $io_print("FAIL T06.4"); throw("assert"); }
$io_print("OK");

// 5. 多层嵌套路径
ns = map();
ns.a = map();
ns.a.b = [0, 1, 2];
var deep = "ns.a.b[1]";
v = @deep;
$io_print("T06.5 ns.a.b[1]:", v);
if (v != 1) { $io_print("FAIL T06.5"); throw("assert"); }
$io_print("OK");

// 6. 写多层嵌套路径
@deep = 77;
$io_print("T06.6 write ns.a.b[1]:", ns.a.b[1]);
if (ns.a.b[1] != 77) { $io_print("FAIL T06.6"); throw("assert"); }
$io_print("OK");

// 7. @(expr) 路径字符串
var arr2 = [100, 200];
var indexStr = "arr2[1]";
var viaExpr = @(indexStr);
$io_print("T06.7 @(expr) path:", viaExpr);
if (viaExpr != 200) { $io_print("FAIL T06.7"); throw("assert"); }
$io_print("OK");

// 8. 复合路径: 带点的 key 访问 map
ns = map();
ns.data = map();
ns.data.name = "test";
var nm = "ns.data.name";
var nameVal = @nm;
$io_print("T06.8 dotted path:", nameVal);
if (nameVal != "test") { $io_print("FAIL T06.8"); throw("assert"); }
$io_print("OK");

$io_print("T06 all passed");
