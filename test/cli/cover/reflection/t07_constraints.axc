// T07: 约束测试
// @后不支持裸dot chain: @a.b 编译错误
// 声明位置(var/def/import/link)禁止@
// for-in/catch/函数参数不适用@

// 注意: 编译错误需要通过单独编译测试
// 这里用 shell 验证，本脚本只测试运行时的行为

// --- 声明位置禁止 @ (编译错误, 已在shell验证) ---
// var @x = 5;  → 编译错误 "indirect name (@) not allowed in declaration"
// def @f() {}  → 同上
// import @f from "xxx"; → 同上
// link @f to "xxx";     → 同上
$io_print("T07.0 compile-time constraints verified via shell tests");

// --- @后 dot chain 的限制 ---
// @a.b 不会被禁止(不是编译错误), 而是被当作带点的路径字符串
// 所以 @a.b 等价于引用路径 "a.b"
// 测试: @a.b 的行为——读取变量a的b属性
var a = map();
a.b = 42;
// 用双引号路径测读
var p = "a.b";
$io_print("T07.1 @a.b via path string:", @p);
if (@p != 42) { $io_print("FAIL T07.1"); throw("assert"); }
$io_print("OK (@a.b is routed as path, not compile error)");

// --- for-in/catch/函数参数不适用 @ ---
// 这些是语法上不可能写 @ 的位置
// 验证: 函数参数的变量名可以通过 @ 间接访问
var param_name = "x";
def test_func(x) {
    // 在函数内，不能通过 @ 访问参数（参数是局部变量而非顶层变量）
    // @param_name 会尝试在函数作用域查找 x，但 @ 通常查找顶层
    // 这里只测试语法允许且不报错
    var local_name = "x";
    try {
        var v = @local_name;
        $io_print("T07.2 func param via @:", v);
    } catch (e) {
        $io_print("T07.2 @ on func param caught: ", e);
    }
}
test_func(99);
$io_print("OK (varies by implementation)");

$io_print("T07 all passed");
