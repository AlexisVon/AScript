// Demo: Quick operator verification

// Arithmetic
$io_print("10+3=%1\n", 10 + 3);
$io_print("10-3=%1\n", 10 - 3);
$io_print("10*3=%1\n", 10 * 3);
$io_print("10/3=%1\n", 10 / 3);
$io_print("10%%3=%1\n", 10 % 3);

// Comparison
$io_print("10>3: %1\n", 10 > 3);
$io_print("10==10: %1\n", 10 == 10);
$io_print("10!=3: %1\n", 10 != 3);

// Logical
$io_print("true&&false: %1\n", true && false);
$io_print("true||false: %1\n", true || false);
$io_print("!true: %1\n", !true);

// Bitwise
$io_print("0xFF&0x0F=0x%1\n", 0xFF & 0x0F);
$io_print("1<<4=%1\n", 1 << 4);

// String concat
$io_print("hello + world: %1\n", "hello" + " world");

// Ternary
$io_print("true?1:0 = %1\n", true ? 1 : 0);

// Increment
var x = 10;
$io_print("x++=%1, x=%2\n", x++, x);

$io_print("demo_operators: OK\n");
