// 类型边界 — int 边界值、float 特殊值
// 注意：整数字面量不能直接写超过 INT64_MAX 的值，需要构造
$io_print("--- test_bounds ---");

// INT64_MAX = 9223372036854775807
var max_val = 9223372036854775800 + 7;
$io_print("INT64_MAX = %1", max_val);

// INT64_MIN = -9223372036854775808
var min1 = -9223372036854775807;
var min_val = min1 - 1;
$io_print("INT64_MIN = %1", min_val);

$io_print("INT64_MAX - 1 = %1", max_val - 1);
$io_print("INT64_MIN + 1 = %1", min_val + 1);

// float 除零行为 — 引擎检测除零错误
try {
    $io_print("1.0/0.0 = %1", 1.0/0.0);
} catch (e) {
    var tp = e.what;
    $io_print("1.0/0.0 throws: %1", tp);
}

try {
    $io_print("-1.0/0.0 = %1", -1.0/0.0);
} catch (e) {
    var tp = e.what;
    $io_print("-1.0/0.0 throws: %1", tp);
}

try {
    $io_print("0.0/0.0 = %1", 0.0/0.0);
} catch (e) {
    var tp = e.what;
    $io_print("0.0/0.0 throws: %1", tp);
}
