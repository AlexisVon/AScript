// 3.6 真值规则 — bool/int/float 在控制流中的行为
$io_print("--- test_truthy_basic ---");

// int: 0 = falsy, 非0 = truthy
if (1) { $io_print("int 1 is truthy in if"); } else { $io_print("int 1 is falsy in if - BUG"); }
if (0) { $io_print("int 0 is truthy in if - BUG"); } else { $io_print("int 0 is falsy in if"); }
if (-1) { $io_print("int -1 is truthy in if"); } else { $io_print("int -1 is falsy in if - BUG"); }

// int in while
var i = 2;
while (i) { $io_print("while int i=%1", i); i = i - 1; }

// int in for
var j;
for (j = 3; j; j = j - 1) { $io_print("for int j=%1", j); }

// bool in if
if (true) { $io_print("bool true is truthy"); } else { $io_print("bool true falsy - BUG"); }
if (false) { $io_print("bool false truthy - BUG"); } else { $io_print("bool false is falsy"); }

// float in if
if (1.5) { $io_print("float 1.5 is truthy"); } else { $io_print("float 1.5 falsy - BUG"); }
if (0.0) { $io_print("float 0.0 truthy - BUG"); } else { $io_print("float 0.0 is falsy"); }
if (-3.14) { $io_print("float -3.14 is truthy"); } else { $io_print("float -3.14 falsy - BUG"); }

// && and || with int
$io_print("1 && 2 = %1", 1 && 2);
$io_print("0 && 2 = %1", 0 && 2);
$io_print("1 || 0 = %1", 1 || 0);
$io_print("0 || 2 = %1", 0 || 2);

// ! with int
$io_print("!0 = %1", !0);
$io_print("!1 = %1", !1);
