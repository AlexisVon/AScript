// Test 5b: 函数调用推帧
def outer_f() {
    var of_v; of_v = "outer";
    def inner_f() {
        var inf_v; inf_v = "inner";
        if (of_v == "outer") { $io_print("PASS: 5b inner reads outer\n"); } else { $io_print("FAIL\n"); }
        return inf_v;
    }
    return inner_f();
}
var r; r = outer_f();
if (r == "inner") { $io_print("PASS: 5b inner returns own var\n"); } else { $io_print("FAIL\n"); }
