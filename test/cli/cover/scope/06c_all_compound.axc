// Test 6c: 所有复合赋值类型
var t; t = 100;
t += 10; t -= 20; t *= 2; t /= 3;
if (t != 60) { $io_print("FAIL: t=" + string(t) + "\n"); }
var m; m = 17;
m %= 5;
if (m != 2) { $io_print("FAIL: m%=" + string(m) + "\n"); }
var s; s = 8;
s <<= 2; s >>= 1;
if (s != 16) { $io_print("FAIL: s=" + string(s) + "\n"); }
var b; b = 0b1100;
b &= 0b1010; b |= 0b0101; b ^= 0b0110;
if (b != 0b1011) { $io_print("FAIL: b=" + string(b) + "\n"); }
var s2; s2 = "hello";
s2 += " world";
if (s2 != "hello world") { $io_print("FAIL: s2=" + s2 + "\n"); }
$io_print("PASS: 6c all compound assign types\n");
