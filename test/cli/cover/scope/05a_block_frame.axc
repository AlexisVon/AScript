// Test 5a: block {} 隐式推帧
var outer; outer = "before";
{
    var inner; inner = "inside";
    outer = "modified";
}
if (outer == "modified") { $io_print("PASS: 5a outer modified from block\n"); } else { $io_print("FAIL\n"); }
var caught; caught = false;
try { tmp = inner; } catch (e) { caught = true; }
if (caught) { $io_print("PASS: 5a inner not visible outside block\n"); } else { $io_print("FAIL: 5a inner leaked or no error\n"); }
