// Loopback: one script serves a point table and drives it through its own client handle -- the
// closed loop, no simulator, no hardware. listen returns the server handle, open the client one;
// the same define/get/set/wait verbs run on both.

link "cip.so" as cip;

var loop_addr = "127.0.0.1:44834";

var srv = cip.listen(loop_addr);
cip.define_dint(srv, "Count");
cip.define_int(srv, "Basket", 3);
cip.define_bool(srv, "Ready");
cip.define_string(srv, "Label");
cip.define_byte(srv, "Raw", 4);
cip.define_byte(srv, "Pad", [2, 3]);
$io_print("local=%1\n", cip.get(srv, ["Count", "Basket", "Ready"]));

var cli = cip.open(loop_addr, 2000);
cip.define_dint(cli, "Count");
cip.define_int(cli, "Basket", 3);
cip.define_bool(cli, "Ready");
cip.define_string(cli, "Label");
cip.define_byte(cli, "Raw", 4);
cip.define_byte(cli, "Pad", [2, 3]);

// The machine's own side sets a point; the wire reads it back.
$io_print("set Count(srv)=%1\n", cip.set(srv, "Count", 7));
$io_print("read Count=%1\n", cip.get(cli, "Count"));

// The wire writes; the machine's own side sees it.
$io_print("set Basket=%1\n", cip.set(cli, "Basket", [4, 5, 6]));
$io_print("server sees=%1\n", cip.get(srv, "Basket"));
$io_print("read range=%1\n", cip.get(cli, "Basket[1,3]"));

// No declared length: a value past any old capacity goes through whole, both directions.
$io_print("set Label=%1\n", cip.set(cli, "Label", "ok"));
$io_print("Label=%1\n", cip.get(cli, "Label"));
$io_print("set Label long=%1\n", cip.set(cli, "Label", "a label longer than eight"));
$io_print("Label long=%1\n", cip.get(srv, "Label"));

// Byte points: one element is one byte. A single element reads and writes as an int, a run as
// bytes -- a string writes its own characters and zeroes the rest of the run.
$io_print("set Raw=%1\n", cip.set(cli, "Raw", bytes("ABCD")));
$io_print("Raw=%1\n", vec(string(cip.get(cli, "Raw"))));
$io_print("Raw[1]=%1\n", cip.get(cli, "Raw[1]"));
$io_print("set Raw[1,3]=%1\n", cip.set(cli, "Raw[1,3]", "xy"));
$io_print("Raw after=%1\n", vec(string(cip.get(srv, "Raw"))));
$io_print("set Raw[0]=%1\n", cip.set(cli, "Raw[0]", 90));
$io_print("Raw after 0=%1\n", vec(string(cip.get(srv, "Raw"))));
$io_print("set Pad[1]=%1\n", cip.set(cli, "Pad[1]", "hi"));
$io_print("Pad=%1\n", vec(string(cip.get(srv, "Pad"))));
$io_print("set Pad[0][1]=%1\n", cip.set(cli, "Pad[0][1]", 7));
$io_print("Pad[0][1]=%1\n", cip.get(cli, "Pad[0][1]"));

// A 2-D point: rows x columns, row-major, and the tag's trailing brackets are its indices. Two of
// them are one element ([1][2]), a range is the last one ([0][1,3), the script's own slice rule),
// one alone is that whole row, and no index is the whole point, back in its nested shape.
cip.define_sint(srv, "Grid", [2, 3]);
cip.define_sint(cli, "Grid", [2, 3]);
$io_print("row 0=%1\n", cip.get(srv, "Grid[0]"));
$io_print("set cell=%1\n", cip.set(srv, "Grid[1][2]", 9));
$io_print("cell=%1\n", cip.get(cli, "Grid[1][2]"));
$io_print("row 1=%1\n", cip.get(cli, "Grid[1]"));
$io_print("range=%1\n", cip.get(cli, "Grid[0][1,3]"));
$io_print("set row=%1\n", cip.set(cli, "Grid[1][0,3]", [7, 8, 9]));
$io_print("whole=%1\n", cip.get(cli, "Grid"));
$io_print("set whole=%1\n", cip.set(cli, "Grid", [[1, 2, 3], [4, 5, 6]]));
$io_print("after=%1\n", cip.get(srv, "Grid"));
$io_print("shape=%1\n", cip.points(srv)["Grid"]);

// A tag the server does not carry: the client gets null and a reason (status 0x05), and the
// session survives.
$io_print("missing=%1 reason=%2\n", cip.get(cli, "Nope"), cip.error(cli));

// wait(): the condition is the script's own function, fed what get() would hand back. A server
// handle reads the local table once up front and then only on a write event, a client handle
// samples on its period; either way false at the deadline, the last value in the reason.
def is_two(v) { return v == 2; }
def row_two(v) { return v[0] == 4 && v[1] == 5 && v[2] == 6; }
def is_99(v) { return v == 99; }
$io_print("wait holds=%1\n", cip.wait(cli, "Grid[0][1]", is_two, 500));
$io_print("wait row=%1\n", cip.wait(cli, "Grid[1]", row_two, 500));
$io_print("wait out=%1 reason=%2\n", cip.wait(srv, "Count", is_99, 150), cip.error(srv));

cip.close(cli);
cip.close(srv);
$io_print("alive=%1\n", cip.alive(srv));
